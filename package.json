{
  "name": "aegisface-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Offline Facial Recognition & Liveness Attendance System for NHAI Field Personnel (Datalake 3.0)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "npm run start:frontend",
    "start:frontend": "npm --prefix frontend start",
    "start:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend start",
    "dev:backend": "npm --prefix backend run dev",
    "build:backend": "npm --prefix backend run build",
    "test:backend": "npm --prefix backend test",
    "seed:backend": "npm --prefix backend run seed",
    "typecheck:frontend": "npm --prefix frontend run type-check",
    "typecheck:backend": "npm --prefix backend run build",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "lint:frontend": "npm --prefix frontend run lint",
    "install:all": "npm install --prefix frontend && npm install --prefix backend"
  },
  "keywords": [
    "nhai",
    "facial-recognition",
    "liveness-detection",
    "offline-first",
    "react-native",
    "expo",
    "tflite",
    "mobilefacenet",
    "sqlite",
    "attendance"
  ],
  "author": "Lokith007",
  "license": "MIT"
}
